FILE_TYPE=LIBRARY_PARTS;
primitive 'SFP_TOP';
  pin
    'VEER_1':
      PIN_NUMBER='(11)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'RD-':
      PIN_NUMBER='(12)';
      INPUT_LOAD='(-0.01,0.01)';
    'RD+':
      PIN_NUMBER='(13)';
      INPUT_LOAD='(-0.01,0.01)';
    'VEER_2':
      PIN_NUMBER='(14)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VCCR':
      PIN_NUMBER='(15)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VCCT':
      PIN_NUMBER='(16)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VEET_1':
      PIN_NUMBER='(17)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'TD+':
      PIN_NUMBER='(18)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'TD-':
      PIN_NUMBER='(19)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VEET_2':
      PIN_NUMBER='(20)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='SFP_TOP';
    BODY_NAME='SFP_TOP';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
