FILE_TYPE=LIBRARY_PARTS;
primitive 'LM75';
  pin
    'A2':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'A1':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'A0':
      PIN_NUMBER='(7)';
      INPUT_LOAD='(-0.01,0.01)';
    'SCL':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      ALLOW_CONNECT='TRUE';
    'OS':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'SDA':
      PIN_NUMBER='(1)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NAME='LM75';
    BODY_NAME='LM75';
    JEDEC_TYPE='nso-8';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
