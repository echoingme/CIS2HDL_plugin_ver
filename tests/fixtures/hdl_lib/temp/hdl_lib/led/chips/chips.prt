FILE_TYPE=LIBRARY_PARTS;
primitive 'LED';
  pin
    'ANODE':
      PIN_NUMBER='(1)';
      PIN_TYPE='ANALOG';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'CATHODE':
      PIN_NUMBER='(2)';
      PIN_TYPE='ANALOG';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='LED';
    BODY_NAME='LED';
    JEDEC_TYPE='led_0805';
    PHYS_DES_PREFIX='LED';
    CLASS='DISCRETE';
  end_body;
end_primitive;

