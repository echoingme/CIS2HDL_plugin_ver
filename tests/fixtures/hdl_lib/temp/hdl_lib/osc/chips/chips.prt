FILE_TYPE=LIBRARY_PARTS;
primitive 'OSC_4';
  pin
    'GND':
      PIN_NUMBER='(2)';
      PINUSE='GROUND';
    'OUT':
      PIN_NUMBER='(3)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VCC':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
    'NC':
      PIN_NUMBER='(1)';
      PINUSE='NC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='OSC_4';
    BODY_NAME='OSC';
    PHYS_DES_PREFIX='OSC';
    CLASS='DISCRETE';
  end_body;
end_primitive;

END.
