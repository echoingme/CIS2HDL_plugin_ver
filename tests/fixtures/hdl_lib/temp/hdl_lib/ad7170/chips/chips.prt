FILE_TYPE=LIBRARY_PARTS;
primitive 'AD7170';
  pin
    'SCLK':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'DOUT/RDY':
      PIN_NUMBER='(2)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'AIN_P':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'AIN_N':
      PIN_NUMBER='(4)';
      INPUT_LOAD='(-0.01,0.01)';
    'REFIN_P':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'REFIN_N':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND_1':
      PIN_NUMBER='(7)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VDD':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'PDRST':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND_2':
      PIN_NUMBER='(10)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'EPAD':
      PIN_NUMBER='(11)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='AD7170';
    BODY_NAME='AD7170';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
