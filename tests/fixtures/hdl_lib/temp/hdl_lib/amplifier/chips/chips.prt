FILE_TYPE=LIBRARY_PARTS;
primitive 'SGM321';
  pin
    'VS+':
      PIN_NUMBER='(5)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VS-':
      PIN_NUMBER='(2)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'IN+':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN-':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'OUT':
      PIN_NUMBER='(4)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NAME='SGM321';
    BODY_NAME='AMPLIFIER';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

primitive 'LM393';
  pin
    'VS+':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'VS-':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'IN+1':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN+2':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN-1':
      PIN_NUMBER='(2)';
      INPUT_LOAD='(-0.01,0.01)';
    'IN-2':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'OUT1':
      PIN_NUMBER='(1)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'OUT2':
      PIN_NUMBER='(7)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NAME='LM393';
    BODY_NAME='AMPLIFIER';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
