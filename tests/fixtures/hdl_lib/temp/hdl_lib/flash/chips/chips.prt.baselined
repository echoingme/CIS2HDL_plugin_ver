FILE_TYPE=LIBRARY_PARTS;
primitive 'SPI_FLASH_8';
  pin
    'VCC':
      PIN_NUMBER='(8)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'SO':
      PIN_NUMBER='(2)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'SI':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'SCK':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'CS':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'WP':
      PIN_NUMBER='(3)';
      INPUT_LOAD='(-0.01,0.01)';
    'HOLD':
      PIN_NUMBER='(7)';
      INPUT_LOAD='(-0.01,0.01)';
  end_pin;
  body
    PART_NAME='SPI_FLASH_8';
    BODY_NAME='SPI_FLASH_8';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
