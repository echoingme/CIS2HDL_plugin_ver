      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='USB3_V';
    BODY_NAME='INTERFACE';
    PHYS_DES_PREFIX='XS';
    CLASS='DISCRETE';
  end_body;
end_primitive;

END.
