    '1':
      PIN_NUMBER='(1)';
      PINUSE='UNSPEC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='TEST_MARK';
    BODY_NAME='MARK';
    PHYS_DES_PREFIX='TP';
    CLASS='DISCRETE';
  end_body;
end_primitive;

primitive 'MARK';
