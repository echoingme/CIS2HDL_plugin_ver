FILE_TYPE=LIBRARY_PARTS;
primitive 'FT232RL';
  pin
    'TXD':
      PIN_NUMBER='(1)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'DTR':
      PIN_NUMBER='(2)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'RTS':
      PIN_NUMBER='(3)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'VCCIO':
      PIN_NUMBER='(4)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'RXD':
      PIN_NUMBER='(5)';
      INPUT_LOAD='(-0.01,0.01)';
    'RI':
      PIN_NUMBER='(6)';
      INPUT_LOAD='(-0.01,0.01)';
    'GND_1':
      PIN_NUMBER='(7)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'NC_1':
      PIN_NUMBER='(8)';
      PINUSE='UNSPEC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'DSR':
      PIN_NUMBER='(9)';
      INPUT_LOAD='(-0.01,0.01)';
    'DCD':
      PIN_NUMBER='(10)';
      INPUT_LOAD='(-0.01,0.01)';
    'CTS':
      PIN_NUMBER='(11)';
      INPUT_LOAD='(-0.01,0.01)';
    'CBUS4':
      PIN_NUMBER='(12)';
      INPUT_LOAD='(-0.01,0.01)';
    'CBUS2':
      PIN_NUMBER='(13)';
      INPUT_LOAD='(-0.01,0.01)';
    'CBUS3':
      PIN_NUMBER='(14)';
      INPUT_LOAD='(-0.01,0.01)';
    'USBDP':
      PIN_NUMBER='(15)';
      BIDIRECTIONAL='TRUE';
      INPUT_LOAD='(-0.01,0.01)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'USBDM':
      PIN_NUMBER='(16)';
      BIDIRECTIONAL='TRUE';
      INPUT_LOAD='(-0.01,0.01)';
      OUTPUT_LOAD='(1.0,-1.0)';
    '3V3OUT':
      PIN_NUMBER='(17)';
      OUTPUT_LOAD='(1.0,-1.0)';
    'GND_2':
      PIN_NUMBER='(18)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'RESET':
      PIN_NUMBER='(19)';
      INPUT_LOAD='(-0.01,0.01)';
    'VCC':
      PIN_NUMBER='(20)';
      PINUSE='POWER';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GND_3':
      PIN_NUMBER='(21)';
      PINUSE='GROUND';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'CBUS1':
      PIN_NUMBER='(22)';
      INPUT_LOAD='(-0.01,0.01)';
    'CBUS0':
      PIN_NUMBER='(23)';
      INPUT_LOAD='(-0.01,0.01)';
    'NC_2':
      PIN_NUMBER='(24)';
      PINUSE='UNSPEC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'AGND':
      PIN_NUMBER='(25)';
      PINUSE='UNSPEC';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'TEST':
      PIN_NUMBER='(26)';
      INPUT_LOAD='(-0.01,0.01)';
    'OSCI':
      PIN_NUMBER='(27)';
      INPUT_LOAD='(-0.01,0.01)';
    'OSCO':
      PIN_NUMBER='(28)';
      OUTPUT_LOAD='(1.0,-1.0)';
  end_pin;
  body
    PART_NAME='FT232RL';
    BODY_NAME='FT232RL';
    PHYS_DES_PREFIX='IC';
    CLASS='IC';
  end_body;
end_primitive;

END.
