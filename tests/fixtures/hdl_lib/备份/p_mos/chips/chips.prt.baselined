FILE_TYPE=LIBRARY_PARTS;
primitive 'P_MOS';
  pin
    'DRAIN':
      PIN_NUMBER='(3)';
      PIN_TYPE='ANALOG';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
    'GATE':
      PIN_NUMBER='(1)';
      INPUT_LOAD='(-0.01,0.01)';
    'SOURCE':
      PIN_NUMBER='(2)';
      PIN_TYPE='ANALOG';
      NO_LOAD_CHECK='Both';
      NO_IO_CHECK='Both';
      NO_ASSERT_CHECK='TRUE';
      NO_DIR_CHECK='TRUE';
      ALLOW_CONNECT='TRUE';
  end_pin;
  body
    PART_NAME='P_MOS';
    BODY_NAME='P_MOS';
    PHYS_DES_PREFIX='Q';
    CLASS='DISCRETE';
  end_body;
end_primitive;

END.
